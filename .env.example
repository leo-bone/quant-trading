# Binance API 密钥配置
# 请复制此文件为 .env 并填入你的密钥

# 测试网密钥 (默认使用，不花真钱)
BINANCE_TEST_API_KEY=your_testnet_api_key_here
BINANCE_TEST_SECRET_KEY=your_testnet_secret_key_here

# 实盘密钥 (替换后改为 False 启用)
BINANCE_LIVE_API_KEY=your_live_api_key_here
BINANCE_LIVE_SECRET_KEY=your_live_secret_key_here

# ============= 获取 API 密钥 =============
# 1. 注册 Binance 账号: https://www.binance.com
# 2. 登录后访问: https://www.binance.com/my/settings/api-management
# 3. 创建 API Key (选择现货+合约权限)
# 4. 开启测试网: https://testnet.binance.vision/
# 5. 在测试网获取测试密钥用于模拟交易
